# Allowlist for scripts/check_no_secrets_in_urls.sh
#
# Format:
#   <path-substring>|<line-substring>
#
# Use this only for cases where query-string auth is intentionally part of a
# browser launch-link protocol and the response is no-store/no-referrer.

services_rs/bff_gateway/src/main.rs|.uri("/auth/direct-web/launch?token=test")

# Gotify (self-hosted push) WebSocket stream protocol requires the client
# token as a `?token=` query parameter — the WebSocket browser API
# does not allow custom Authorization headers on connect. This is a
# third-party protocol contract, not an in-house pattern. Scope is the
# single line that builds the connect URL.
clients/shamell_flutter/lib/core/gotify_client.dart|return '$u/stream?token=$token';
