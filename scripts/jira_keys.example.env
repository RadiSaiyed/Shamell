# Example Jira key mappings for CSV placeholder replacement.
# Usage:
#   python3 scripts/replace_jira_placeholders.py \
#     --mapping scripts/jira_keys.example.env \
#     --dry-run \
#     stories.csv subtasks.csv links.csv
#
# Then replace the example values below with your real Jira issue keys and run
# again without --dry-run. The script also replaces {{KEY}} automatically when
# the mapping contains KEY=VALUE.

# Epics
EPIC-KEY-1=COACH-100
EPIC-KEY-2=COACH-101
EPIC-KEY-3=COACH-102
EPIC-KEY-4=COACH-103
EPIC-KEY-5=COACH-104
EPIC-KEY-6=COACH-105

# Stories
STORY-KEY-COACH-001=COACH-201
STORY-KEY-COACH-004=COACH-204
STORY-KEY-COACH-008=COACH-208

# Link placeholders
COACH_001_KEY=COACH-201
COACH_002_KEY=COACH-202
COACH_003_KEY=COACH-203
COACH_004_KEY=COACH-204
COACH_005_KEY=COACH-205
COACH_006_KEY=COACH-206
COACH_007_KEY=COACH-207
COACH_008_KEY=COACH-208
COACH_009_KEY=COACH-209
COACH_010_KEY=COACH-210
COACH_011_KEY=COACH-211
COACH_012_KEY=COACH-212
COACH_013_KEY=COACH-213
COACH_014_KEY=COACH-214
COACH_015_KEY=COACH-215
COACH_016_KEY=COACH-216
COACH_017_KEY=COACH-217
COACH_018_KEY=COACH-218
COACH_019_KEY=COACH-219
COACH_020_KEY=COACH-220
COACH_021_KEY=COACH-221
COACH_022_KEY=COACH-222
