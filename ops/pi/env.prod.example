# Shamell production env template (Rust + Postgres)
ENV=prod
SHAMELL_DEPLOYMENT_PROFILE=ops-pi

# Required secrets
INTERNAL_API_SECRET=change-me
BFF_SECURITY_ALERT_ALLOWED_CALLERS=security-reporter
BFF_ACCESS_ASSIGNMENT_ALLOWED_CALLERS=control-automation,iam-sync
BFF_ACCESS_ASSIGNMENT_INTERNAL_IDENTITY_PUBLIC_KEYS=control-automation=replace-with-b64-ed25519-public-key,iam-sync=replace-with-b64-ed25519-public-key
BFF_ACCESS_ASSIGNMENT_INTERNAL_IDENTITY_MAX_SKEW_SECS=30
BFF_ACCESS_ASSIGNMENT_REQUIRE_INTERNAL_IDENTITY_V2=true
BFF_ACCESS_ASSIGNMENT_ALLOW_LEGACY_INTERNAL_SECRET_FALLBACK=false
BFF_SECURITY_ALERT_INTERNAL_IDENTITY_PUBLIC_KEYS=security-reporter=replace-with-b64-ed25519-public-key
BFF_SECURITY_ALERT_INTERNAL_IDENTITY_MAX_SKEW_SECS=30
BFF_SECURITY_ALERT_REQUIRE_INTERNAL_IDENTITY_V2=true
BFF_SECURITY_ALERT_ALLOW_LEGACY_INTERNAL_SECRET_FALLBACK=false
BFF_INTERNAL_SERVICE_ID=bff
BFF_INTERNAL_IDENTITY_SIGNING_SEED_B64=replace-with-b64-32-byte-ed25519-seed
ACCESS_ASSIGNMENT_ADMIN_SERVICE_ID=control-automation
ACCESS_ASSIGNMENT_ADMIN_SIGNING_SEED_B64=replace-with-b64-32-byte-ed25519-seed
ACCESS_ASSIGNMENT_ADMIN_AUDIENCE=bff
PAYMENTS_INTERNAL_SECRET=
PAYMENTS_INTERNAL_ALLOWED_CALLERS=bff
PAYMENTS_INTERNAL_IDENTITY_PUBLIC_KEYS=bff=replace-with-b64-ed25519-public-key
PAYMENTS_INTERNAL_IDENTITY_MAX_SKEW_SECS=30
PAYMENTS_REQUIRE_INTERNAL_IDENTITY_V2=true
PAYMENTS_ALLOW_LEGACY_INTERNAL_SECRET_FALLBACK=false
CHAT_INTERNAL_SECRET=
CHAT_INTERNAL_ALLOWED_CALLERS=bff
CHAT_INTERNAL_IDENTITY_PUBLIC_KEYS=bff=replace-with-b64-ed25519-public-key
CHAT_INTERNAL_IDENTITY_MAX_SKEW_SECS=30
CHAT_REQUIRE_INTERNAL_IDENTITY_V2=true
CHAT_ALLOW_LEGACY_INTERNAL_SECRET_FALLBACK=false
BFF_ROLE_HEADER_SECRET=change-me

# Postgres
POSTGRES_USER=shamell
POSTGRES_PASSWORD=change-me
POSTGRES_DB=postgres
POSTGRES_DB_CORE=shamell_core
POSTGRES_DB_CHAT=shamell_chat
POSTGRES_DB_PAYMENTS=shamell_payments
POSTGRES_DB_REGULATORY=regulator_reporting
POSTGRES_PUBLISH_ADDR=127.0.0.1
POSTGRES_PUBLISH_PORT=5432

DB_URL=postgresql://shamell:change-me@db:5432/shamell_core
AUTH_AUTO_APPLY_SCHEMA=false
CHAT_DB_URL=postgresql://shamell:change-me@db:5432/shamell_chat
PAYMENTS_DB_URL=postgresql://shamell:change-me@db:5432/shamell_payments
REGULATORY_REPORTING_DB_URL=postgresql://shamell:change-me@db:5432/regulator_reporting
REGULATORY_REPORTING_SNAPSHOT_SALT=replace-with-strong-rotation-backed-salt
REGULATOR_RO_USERNAME=regulator_ro
REGULATOR_RO_PASSWORD=replace-with-strong-regulator-readonly-password
REGULATORY_SNAPSHOT_MANIFEST_DIR=/var/lib/shamell/regulatory-snapshots
REGULATORY_SNAPSHOT_SIGNING_KEY_FILE=/etc/shamell/regulatory-snapshot-signing.pem
CHAT_AUTO_APPLY_SCHEMA=false
PAYMENTS_AUTO_APPLY_SCHEMA=false
PAYMENTS_AUTO_PROVISION_FEE_WALLET=false

# BFF security controls
BFF_REQUIRE_INTERNAL_SECRET=true
CHAT_REQUIRE_INTERNAL_SECRET=true
CHAT_ENFORCE_DEVICE_AUTH=true
PAYMENTS_REQUIRE_INTERNAL_SECRET=true
BFF_ENFORCE_ROUTE_AUTHZ=true
CSRF_GUARD_ENABLED=true
AUTH_ACCEPT_LEGACY_SESSION_COOKIE=false
AUTH_DEVICE_LOGIN_WEB_ENABLED=false
AUTH_WEB_DIRECT_ACCESS_ALLOWED_ORIGINS=
AUTH_WEB_DIRECT_ACCESS_ALLOWED_CLIENT_CIDRS=
AUTH_WEB_DIRECT_ACCESS_ACCOUNT_ID=
AUTH_WEB_DIRECT_ACCESS_PHONE=
AUTH_WEB_DIRECT_ACCESS_DEVICE_ID=
AUTH_WEB_DIRECT_LAUNCH_SIGNING_SECRET=
AUTH_WEB_DIRECT_LAUNCH_ALLOWED_REDIRECT_ORIGINS=https://online.shamell.online,https://shamell.online
AUTH_WEB_DIRECT_LAUNCH_MAX_TTL_SECS=604800
SECURITY_HEADERS_ENABLED=true
HSTS_ENABLED=true
CSP_ENABLED=true
BFF_EXPOSE_UPSTREAM_ERRORS=false
BFF_MAX_BODY_BYTES=1048576
BFF_MAX_UPSTREAM_BODY_BYTES=1048576
AUTH_BIOMETRIC_TOKEN_TTL_SECS=7776000
AUTH_BIOMETRIC_LOGIN_WINDOW_SECS=300
AUTH_BIOMETRIC_LOGIN_MAX_PER_IP=60
AUTH_BIOMETRIC_LOGIN_MAX_PER_DEVICE=30
AUTH_CHAT_REGISTER_WINDOW_SECS=300
AUTH_CHAT_REGISTER_MAX_PER_IP=40
AUTH_CHAT_REGISTER_MAX_PER_DEVICE=20
AUTH_CHAT_GET_DEVICE_WINDOW_SECS=300
AUTH_CHAT_GET_DEVICE_MAX_PER_IP=80
AUTH_CHAT_GET_DEVICE_MAX_PER_DEVICE=40
AUTH_CHAT_GET_KEY_BUNDLE_WINDOW_SECS=300
AUTH_CHAT_GET_KEY_BUNDLE_MAX_PER_IP=40
AUTH_CHAT_GET_KEY_BUNDLE_MAX_PER_DEVICE=20
AUTH_CHAT_SEND_REQUIRE_CONTACTS=true
AUTH_CHAT_MAILBOX_WRITE_WINDOW_SECS=60
AUTH_CHAT_MAILBOX_WRITE_MAX_PER_IP=2000
AUTH_CHAT_MAILBOX_WRITE_MAX_PER_DEVICE=120
AUTH_CHAT_MAILBOX_WRITE_MAX_PER_MAILBOX=60
AUTH_DEVICE_LOGIN_WINDOW_SECS=300
AUTH_DEVICE_LOGIN_START_MAX_PER_IP=30
AUTH_DEVICE_LOGIN_REDEEM_MAX_PER_IP=60
AUTH_DEVICE_LOGIN_APPROVE_MAX_PER_PHONE=30
AUTH_DEVICE_LOGIN_REDEEM_MAX_PER_TOKEN=30
AUTH_DEVICE_LOGIN_APPROVE_MAX_PER_TOKEN=20
AUTH_CONTACT_INVITE_TTL_SECS=86400
AUTH_CONTACT_INVITE_WINDOW_SECS=300
AUTH_CONTACT_INVITE_CREATE_MAX_PER_IP=40
AUTH_CONTACT_INVITE_CREATE_MAX_PER_PHONE=20
AUTH_CONTACT_INVITE_REDEEM_MAX_PER_IP=200
AUTH_CONTACT_INVITE_REDEEM_MAX_PER_PHONE=80
AUTH_CONTACT_INVITE_REDEEM_MAX_PER_TOKEN=10
AUTH_MAINTENANCE_INTERVAL_SECS=3600
AUTH_SESSION_IDLE_TTL_SECS=43200
AUTH_SESSION_CLEANUP_GRACE_SECS=86400
AUTH_DEVICE_LOGIN_CLEANUP_GRACE_SECS=86400
AUTH_DEVICE_SESSION_RETENTION_SECS=2592000
AUTH_RATE_LIMIT_RETENTION_SECS=86400
AUTH_ACCOUNT_CREATE_WINDOW_SECS=86400
AUTH_ACCOUNT_CREATE_MAX_PER_IP=50
AUTH_ACCOUNT_CREATE_MAX_PER_DEVICE=1
AUTH_ACCOUNT_CREATE_ENABLED=true
AUTH_ACCOUNT_CREATE_EMERGENCY_POW_ONLY=false
AUTH_ACCOUNT_CREATE_POW_ENABLED=true
AUTH_ACCOUNT_CREATE_POW_TTL_SECS=300
AUTH_ACCOUNT_CREATE_POW_DIFFICULTY_BITS=18
AUTH_ACCOUNT_CREATE_POW_SECRET=change-me
AUTH_ACCOUNT_CREATE_HARDWARE_ATTESTATION_ENABLED=true
AUTH_ACCOUNT_CREATE_REQUIRE_HARDWARE_ATTESTATION=true
AUTH_ACCOUNT_CREATE_APPLE_DEVICECHECK_TEAM_ID=change-me
AUTH_ACCOUNT_CREATE_APPLE_DEVICECHECK_KEY_ID=change-me
AUTH_ACCOUNT_CREATE_APPLE_DEVICECHECK_PRIVATE_KEY_P8_B64=change-me
AUTH_ACCOUNT_CREATE_GOOGLE_PLAY_INTEGRITY_SERVICE_ACCOUNT_JSON_B64=change-me
AUTH_ACCOUNT_CREATE_GOOGLE_PLAY_INTEGRITY_ALLOWED_PACKAGE_NAMES=online.shamell.app,online.shamell.app.operator,online.shamell.app.admin
AUTH_ACCOUNT_CREATE_GOOGLE_PLAY_INTEGRITY_REQUIRE_STRONG_INTEGRITY=true
AUTH_ACCOUNT_CREATE_GOOGLE_PLAY_INTEGRITY_REQUIRE_PLAY_RECOGNIZED=true
AUTH_ACCOUNT_CREATE_GOOGLE_PLAY_INTEGRITY_REQUIRE_LICENSED=false
AUTH_ACCOUNT_CREATE_CHALLENGE_WINDOW_SECS=300
AUTH_ACCOUNT_CREATE_CHALLENGE_MAX_PER_IP=2000
AUTH_ACCOUNT_CREATE_CHALLENGE_MAX_PER_DEVICE=60
AUTH_PAYMENT_MUTATION_HARDWARE_ATTESTATION_ENABLED=true
AUTH_PAYMENT_MUTATION_HARDWARE_ATTESTATION_TTL_SECS=120
# Emergency-only: comma-separated allowlist to bypass payment mutation hardware attestation.
# Example: payments_create_user,payments_topup,payments_transfer
AUTH_PAYMENT_MUTATION_ATTESTATION_EMERGENCY_BYPASS_OPERATIONS=
AUTH_BIOMETRIC_ENROLL_HARDWARE_ATTESTATION_ENABLED=false
AUTH_BIOMETRIC_ENROLL_HARDWARE_ATTESTATION_TTL_SECS=120
AUTH_BIOMETRIC_LOGIN_HARDWARE_ATTESTATION_ENABLED=false
AUTH_BIOMETRIC_LOGIN_HARDWARE_ATTESTATION_TTL_SECS=120
SECURITY_ALERT_WINDOW_SECS=300
SECURITY_ALERT_COOLDOWN_SECS=600
SECURITY_ALERT_SERVICE=bff,chat
SECURITY_ALERT_THRESHOLDS=device_login_approve.blocked:5,device_login_redeem.blocked:5,biometric_login.blocked:10,biometric_token_rotate.failed:1,auth_rate_limit_exceeded.blocked:30,admin_role_mutation.blocked:1,admin_role_mutation.failed:1,ride_sensitive_mutation.blocked:1,ride_sensitive_mutation.failed:1,chat_protocol_downgrade.blocked:1,chat_key_bundle_policy.blocked:1,chat_key_register_policy.blocked:1
SECURITY_ALERT_WEBHOOK_URL=http://127.0.0.1:8080/internal/security/alerts
SECURITY_ALERT_WEBHOOK_INTERNAL_SECRET=
SECURITY_ALERT_WEBHOOK_SERVICE_ID=security-reporter
SECURITY_ALERT_WEBHOOK_SIGNING_SEED_B64=replace-with-b64-32-byte-ed25519-seed

# Ride/auth data protection and backup controls
HOST_STORAGE_ENCRYPTION_REQUIRED=true
RIDE_RECORD_HARD_DELETE_ENABLED=false
RIDE_DB_BACKUP_OUTPUT_DIR=/var/backups/shamell
RIDE_DB_BACKUP_RETENTION_DAYS=30
RIDE_DB_BACKUP_ENCRYPTION_MODE=age
RIDE_DB_BACKUP_AGE_RECIPIENT=age1replace-with-backup-recipient
RIDE_DB_BACKUP_PG_DUMP_FORMAT=custom

# Edge trust
BFF_TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
ALLOWED_HOSTS=api.shamell.online,online.shamell.online
ALLOWED_ORIGINS=https://online.shamell.online,https://shamell.online
WORKFORCE_OIDC_ISSUER_URL=https://iam.shamell.online
WORKFORCE_OIDC_CLIENT_ID=shamell-control-web
WORKFORCE_OIDC_AUDIENCE=shamell-workforce
WORKFORCE_OIDC_JWKS_URL=https://iam.shamell.online/oauth/v2/keys
CLOUDFLARE_ACCESS_TEAM_DOMAIN=shamell.cloudflareaccess.com
CLOUDFLARE_ACCESS_AUDIENCES=control-prod,ops-prod,coach-operators-prod,crew-prod,cash-prod
WORKFORCE_SESSION_TTL_SECS=28800
WORKFORCE_BREAK_GLASS_SESSION_TTL_SECS=900
WORKFORCE_STEP_UP_ENABLED=true

# Service URLs
# Internal service-to-service calls run on an isolated Docker network.
# Keep this explicit while upstream mTLS rollout is pending.
BFF_ALLOW_INSECURE_UPSTREAM_HTTP=true
CHAT_BASE_URL=http://chat:8081
CHAT_PUSH_TOKEN_ENCRYPTION_KEY_B64=replace-with-base64-32-byte-key
FCM_SERVER_KEY=
BFF_TOMTOM_API_KEY=
BFF_TOMTOM_BASE_URL=https://api.tomtom.com
CHAT_PROTOCOL_V2_ENABLED=true
CHAT_PROTOCOL_V1_WRITE_ENABLED=false
CHAT_PROTOCOL_V1_READ_ENABLED=false
CHAT_PROTOCOL_REQUIRE_V2_FOR_GROUPS=true
CHAT_MAILBOX_API_ENABLED=false
CHAT_MAILBOX_INACTIVE_RETENTION_SECS=86400
CHAT_MAILBOX_CONSUMED_RETENTION_SECS=3600
PAYMENTS_BASE_URL=http://payments:8082

# Payments
PAYMENTS_MAX_BODY_BYTES=1048576
PAYMENTS_ALLOW_DIRECT_TOPUP=false
# Emergency-only override for controlled demos / incident recovery.
PAYMENTS_EMERGENCY_DIRECT_TOPUP_ENABLED=false
PAYMENTS_ADMIN_CREDIT_MAX_AMOUNT_CENTS=10000000000
PAYMENTS_ADMIN_CREDIT_OPERATOR_DAILY_LIMIT_CENTS=10000000000
PAYMENTS_ADMIN_CREDIT_APPROVAL_THRESHOLD_CENTS=0

# LiveKit (must be strong values in prod)
LIVEKIT_PUBLIC_URL=wss://livekit.shamell.online
LIVEKIT_API_KEY=change-me
LIVEKIT_API_SECRET=change-me
LIVEKIT_TOKEN_ENDPOINT_ENABLED=false
LIVEKIT_TOKEN_TTL_SECS=300
LIVEKIT_TOKEN_MAX_TTL_SECS=3600
LIVEKIT_TOKEN_RATE_WINDOW_SECS=60
LIVEKIT_TOKEN_MAX_PER_PHONE=30
LIVEKIT_TOKEN_MAX_PER_IP=80

# TURN relay for mobile WebRTC (voice/video calls)
TURN_EXTERNAL_IP=
TURN_REALM=shamell.online
TURN_USERNAME=change-me-turn
TURN_PASSWORD=change-me-turn-secret
TURN_LISTEN_ADDR=0.0.0.0
TURN_LISTEN_PORT=3478
TURN_RELAY_MIN_PORT=49160
TURN_RELAY_MAX_PORT=49200

# Mobile build-time WebRTC ICE config (pass as --dart-define)
SHAMELL_CALL_STUN_URLS=stun:stun.l.google.com:19302
SHAMELL_CALL_TURN_URLS=
SHAMELL_CALL_TURN_USERNAME=
SHAMELL_CALL_TURN_CREDENTIAL=
# Optional full JSON override (takes precedence when non-empty)
# SHAMELL_CALL_ICE_SERVERS_JSON=[{"urls":["stun:stun.example:3478","turn:turn.example:3478?transport=udp"],"username":"u","credential":"p"}]
