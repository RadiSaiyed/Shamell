[Unit]
Description=Shamell encrypted ride/auth database backup
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=root
Group=root
EnvironmentFile=-/etc/default/shamell-ride-db-backup
SuccessExitStatus=75
ExecStart=/usr/bin/flock -n -E 75 /run/shamell-ride-db-backup.lock /usr/bin/env bash -lc 'set -euo pipefail; APP_DIR="$${APP_DIR:-/opt/shamell}"; BACKUP_SCRIPT="$${APP_DIR}/scripts/ride_db_backup.sh"; [[ -x "$${BACKUP_SCRIPT}" ]] || { echo "missing ride db backup script: $${BACKUP_SCRIPT}" >&2; exit 1; }; export COMPOSE_FILE="$${COMPOSE_FILE:-$${APP_DIR}/ops/pi/docker-compose.postgres.yml}"; export ENV_FILE="$${ENV_FILE:-$${APP_DIR}/ops/pi/.env}"; export RIDE_DB_BACKUP_OUTPUT_DIR="$${RIDE_DB_BACKUP_OUTPUT_DIR:-/var/backups/shamell}"; cd "$${APP_DIR}"; "$${BACKUP_SCRIPT}"'

[Install]
WantedBy=multi-user.target
