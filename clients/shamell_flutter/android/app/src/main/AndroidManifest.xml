<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
  <uses-permission android:name="android.permission.INTERNET" />
  <!-- Keep both location permissions: the app actively uses high/best accuracy
       flows, and geolocator_android supports Android 12 approximate location
       by requesting fine+coarse together when both are declared. -->
  <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
  <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
  <uses-permission android:name="android.permission.WAKE_LOCK" />
  <!-- Let Android reschedule Driver background work after a device reboot. -->
  <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
  <!-- Keep CAMERA: the app uses QR scanning via mobile_scanner and still-image
       capture via image_picker in chat, groups, and moments. -->
  <uses-permission android:name="android.permission.CAMERA" />
  <!-- Android 13+ notifications permission -->
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <!-- VoIP: microphone capture for audio/video calls + LiveKit-driven
       audio routing (speakerphone toggle, Bluetooth headset selection). -->
  <uses-permission android:name="android.permission.RECORD_AUDIO" />
  <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
  <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
  <!-- Without VIBRATE the per-channel enableVibration flag is silently ignored
       by Android and notifications never haptic, regardless of channel config. -->
  <uses-permission android:name="android.permission.VIBRATE" />
  <!-- Incoming call full-screen ringer needs SHOW_WHEN_LOCKED + TURN_SCREEN_ON +
       a high-priority full-screen intent. -->
  <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_PHONE_CALL" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
  <uses-permission android:name="android.permission.READ_PHONE_STATE" />
  <uses-permission android:name="android.permission.MANAGE_OWN_CALLS" />
  <application android:label="@string/app_name" android:icon="@mipmap/ic_launcher" android:usesCleartextTraffic="false" android:allowBackup="false" android:fullBackupContent="@xml/backup_rules" android:dataExtractionRules="@xml/data_extraction_rules" android:networkSecurityConfig="@xml/network_security_config" android:extractNativeLibs="false">
    <meta-data android:name="flutterEmbedding" android:value="2" />
    <!-- FCM falls back to this channel when an inbound message does not set
         android.notification.channel_id explicitly. chat_messages_default is
         created in NotificationService.initialize() with playSound + vibration
         enabled, which matches user expectation for chat alerts. -->
    <meta-data
        android:name="com.google.firebase.messaging.default_notification_channel_id"
        android:value="chat_messages_default" />
    <meta-data
        android:name="com.google.firebase.messaging.default_notification_icon"
        android:resource="@mipmap/ic_launcher" />
    <meta-data
        android:name="com.google.firebase.messaging.default_notification_color"
        android:resource="@android:color/holo_green_dark" />
    <activity android:name=".MainActivity" android:exported="true" android:launchMode="singleTop" android:theme="@style/LaunchTheme" android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode" android:hardwareAccelerated="true" android:windowSoftInputMode="adjustResize" android:showWhenLocked="true" android:turnScreenOn="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
      <!-- Security hardening: do not expose unverified custom-scheme inbound
           routes to the OS intent resolver. Only verified HTTPS app links are
           externally routable. -->
      <intent-filter android:autoVerify="true">
        <action android:name="android.intent.action.VIEW" />
        <category android:name="android.intent.category.DEFAULT" />
        <category android:name="android.intent.category.BROWSABLE" />
        <data android:scheme="https" android:host="online.shamell.online" android:pathPrefix="/app/device_login" />
        <data android:scheme="https" android:host="online.shamell.online" android:pathPrefix="/app/invite" />
        <data android:scheme="https" android:host="online.shamell.online" android:pathPrefix="/app/friend" />
        <data android:scheme="https" android:host="online.shamell.online" android:pathPrefix="/app/chat" />
        <data android:scheme="https" android:host="online.shamell.online" android:pathPrefix="/app/miniapp" />
        <data android:scheme="https" android:host="online.shamell.online" android:pathPrefix="/app/mini_program" />
        <data android:scheme="https" android:host="online.shamell.online" android:pathPrefix="/app/moduleapp" />
        <data android:scheme="https" android:host="online.shamell.online" android:pathPrefix="/app/moduleapps" />
        <data android:scheme="https" android:host="online.shamell.online" android:pathPrefix="/app/green_paket" />
        <data android:scheme="https" android:host="online.shamell.online" android:pathPrefix="/app/green_packet" />
        <data android:scheme="https" android:host="online.shamell.online" android:pathPrefix="/app/redpacket" />
        <data android:scheme="https" android:host="online.shamell.online" android:pathPrefix="/app/red_packet" />
        <data android:scheme="https" android:host="online.shamell.online" android:pathPrefix="/app/hongbao" />
        <data android:scheme="https" android:host="online.shamell.online" android:pathPrefix="/app/ride" />
        <data android:scheme="https" android:host="online.shamell.online" android:pathPrefix="/app/taxi" />
        <data android:scheme="https" android:host="online.shamell.online" android:pathPrefix="/app/coach" />
        <data android:scheme="https" android:host="online.shamell.online" android:pathPrefix="/app/bus" />
        <data android:scheme="https" android:host="online.shamell.online" android:pathPrefix="/app/official" />
        <data android:scheme="https" android:host="online.shamell.online" android:pathPrefix="/app/moments" />
        <data android:scheme="https" android:host="online.shamell.online" android:pathPrefix="/app/shake" />
      </intent-filter>
    </activity>
    <!-- Foreground service that owns the looped ringtone for incoming calls.
         `phoneCall` matches the FOREGROUND_SERVICE_PHONE_CALL permission and
         gates legitimate ringer/audio use on Android 14+. The service runs
         only while the user is being rung; cancelled on accept / decline /
         timeout via the corresponding Dart paths. -->
    <service
        android:name=".IncomingCallRingerService"
        android:exported="false"
        android:foregroundServiceType="phoneCall" />
    <!-- Release hardening: remove library-added debug/benchmark receivers that
         do not participate in app functionality but widen the exported surface. -->
    <receiver
        android:name="androidx.work.impl.diagnostics.DiagnosticsReceiver"
        tools:node="remove" />
    <receiver
        android:name="androidx.profileinstaller.ProfileInstallReceiver"
        tools:node="remove" />
  </application>
</manifest>
